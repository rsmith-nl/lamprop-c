# Package name
BASENAME = lamprop

# w64devkit uses gcc as cc.

# The next lines are for building debugging libraries.
DCFLAGS = -pipe -std=c11 -g3 -Wall -Wextra -Wstrict-prototypes \
                -Wmissing-field-initializers -Wpointer-arith
DCFLAGS += -D_POSIX_SOURCE
DLFLAGS = -pipe

# The next lines are for release builds.
CFLAGS = -Os -pipe -std=c11 -ffast-math -march=native
CFLAGS += -D_POSIX_SOURCE
LFLAGS = -pipe

# Other libraries to link against
LIBS += -lm

# Source files.
SRCS = lamprop.c stringview.c sbuf.c parser.c arena.c setup.c core.c
SRCS += matrix.c text.c latex.c html.c utils.c logging.c

##### No editing necessary beyond this point

all: $(BASENAME).exe  ## Compile the program. (default)

debug: $(BASENAME)-debug.exe  ## Compile a debug version of the program.

# This makefile uses a unit build.
$(BASENAME).exe: $(SRCS) version.h
	$(CC) $(CFLAGS) $(LFLAGS) $(LDIRS) -o $(BASENAME) $(SRCS) $(LIBS)

$(BASENAME)-debug.exe: $(SRCS) version.h
	$(CC) $(DCFLAGS) $(DLFLAGS) $(LDIRS) -o $(BASENAME)-debug $(SRCS) $(LIBS)

.PHONY: clean
clean:  ## Remove all generated files.
	rm -f $(BASENAME).exe $(BASENAME)-debug.exe  *~ core gmon.out $(TARFILE) backup-*
